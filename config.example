BVECTORDB_DELETE_PATH=/v1/collections/{collection}/documents/{document_id}
DEFAULT_COLLECTION=default
DEFAULT_TOP_K=8
CHUNK_SIZE=900
CHUNK_OVERLAP=150
REQUEST_TIMEOUT=60
